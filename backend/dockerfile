# backend/Dockerfile
# Build with the REPO ROOT as context (not backend/), since main.py needs
# app/master_resume.json and resume_contact.py at runtime:
#   docker build -t resume-backend:local -f backend/dockerfile .
FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
RUN playwright install --with-deps chromium

# Copy the whole package (not file-by-file) so adding a new backend module
# doesn't also require a Dockerfile edit.
COPY backend/ backend/
COPY resume_contact.py resume_contact.py
COPY app/ app/

EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
