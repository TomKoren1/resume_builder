{
  "title": "Resume Builder",
  "uid": "resume-builder",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Resume generation rate by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (status) (rate(resume_generation_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "LLM latency p95 by provider",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(llm_inference_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Backend errors & warnings",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{app=\"resume_backend\", severity=~\"warning|error\"}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Errors in the last hour",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({app=\"resume_backend\", severity=\"error\"}[1h]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Log volume by pod (all components)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 18 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum by (app) (count_over_time({namespace=\"resume-builder\"}[$__interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "All backend/frontend logs (live tail)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{namespace=\"resume-builder\", app=~\"backend|frontend\"}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active alerts (pending/firing)",
      "description": "Same alerts that post to Slack via Alertmanager - Prometheus exposes each alert rule's live state as the ALERTS metric.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "ALERTS{alertstate=~\"pending|firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true } } }
      ]
    },
    {
      "id": 8,
      "title": "Alert state timeline",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "ALERTS{alertstate=~\"pending|firing\"}",
          "legendFormat": "{{alertname}} ({{alertstate}})"
        }
      ]
    }
  ]
}
